{:paths ["src"]
 :tasks
 {build  {:doc      "Render content/ into a static site in dist/"
          :requires ([site.build :as b])
          :task     (b/build!)}

  dev    {:doc      "Serve dist/ on http://localhost:8080 and rebuild on changes (bb dev 3000 for another port)"
          :requires ([site.dev :as d])
          :task     (apply d/-main *command-line-args*)}

  deploy {:doc     "Build and upload to Cloudflare (needs `npx wrangler login` once)"
          :depends [build]
          :task    (shell "npx wrangler deploy")}}}
