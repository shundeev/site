{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shundeev-dev",
  "compatibility_date": "2026-11-01",

  // Static site only: no Worker script, Cloudflare serves public/ directly.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },

  // Attaches the apex domain; Cloudflare creates the DNS record and certificate.
  "routes": [
    { "pattern": "shundeev.dev", "custom_domain": true }
  ]
}
